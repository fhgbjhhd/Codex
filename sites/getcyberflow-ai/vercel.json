{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "true",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "github": {
    "silent": true
  },
  "rewrites": [
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/affiliate", "destination": "/affiliate.html" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
