POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

N8N_PORT=5678
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
GENERIC_TIMEZONE=UTC
TZ=UTC

# OpenClaw -> n8n bridge settings (export these in the gateway host env)
OPENCLAW_N8N_WEBHOOK_RESEARCH_INGEST_URL=https://n8n.example.com/webhook/research-ingest
OPENCLAW_N8N_CALLBACK_BASE_URL=https://gateway.example.com
OPENCLAW_N8N_STATUS_TOKEN=replace-with-a-shared-secret
